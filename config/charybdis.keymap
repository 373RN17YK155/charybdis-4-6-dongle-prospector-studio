#include <behaviors.dtsi>
#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

// ---------------------------------------------------------------------------
//  СЛОИ РАСКЛАДКИ
//  Номера слоёв важны: на них ссылаются split_input_common.dtsi (трекбол),
//  переключатели режимов и комбинации клавиш. Порядок = порядок ниже.
//
//   0 BASE     — основная раскладка (перенос старой раскладки)
//   1 MOUSE    — авто-слой мыши: появляется при движении шарика
//   2 SYMBOL   — символы
//   3 NUMBER   — цифры и F-клавиши
//   4 FUNCTION — настройки: медиа, BT, reset + переключатели трекбала
//   5 SNIPE    — точное движение шарика (включается тумблером)
//   6 SCROLL   — скролл шариком (включается тумблером)
// ---------------------------------------------------------------------------
#define BASE 0
#define MOUSE 1
#define SYMBOL 2
#define NUMBER 3
#define FUNCTION 4
#define SNIPE 5
#define SCROLL 6

// Позиции для positional home-row-mods (Charybdis 4x6 = 56 клавиш:
// 4 ряда по 12 + 8 клавиш больших пальцев). Позиции идут в порядке
// default_transform: 0-11 (ряд 0), 12-23 (ряд 1), 24-35 (ряд 2),
// 36-47 (ряд 3), 48-55 (большие пальцы: 48-52 левые, 53-55 правые).
#define KEYS_L 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41
#define KEYS_R 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47
#define THUMBS 48 49 50 51 52 53 54 55

&sk {
  release-after-ms = <600>;
  quick-release;
};

&sl {
  ignore-modifiers;
};

&mt {
  flavor = "tap-preferred";
};

&lt {
  flavor = "balanced";
  tapping-term-ms = <200>;
  quick-tap-ms = <175>;
};

&caps_word {
  /delete-property/ ignore-modifiers;
};

/ {
  behaviors {
    hml: hml {
      // 1-й параметр = модификатор (hold), 2-й = буква (tap)
      display-name = "Home Row Mod - Left";
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "balanced";
      tapping-term-ms = <2000>;
      quick-tap-ms = <175>;
      require-prior-idle-ms = <250>;
      hold-trigger-key-positions = <KEYS_R THUMBS>;
      hold-trigger-on-release;
      bindings =
        <&kp>,
        <&kp>;
    };

    hmr: hmr {
      // 1-й параметр = модификатор (hold), 2-й = буква (tap)
      display-name = "Home Row Mod - Right";
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "balanced";
      tapping-term-ms = <2000>;
      quick-tap-ms = <175>;
      require-prior-idle-ms = <250>;
      hold-trigger-key-positions = <KEYS_L THUMBS>;
      hold-trigger-on-release;
      bindings =
        <&kp>,
        <&kp>;
    };

    hml_s: hml_s {
      // как "Left", но срабатывает модом сразу после печати (без задержки 250 мс)
      display-name = "Home Row Mod - Left (no idle)";
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "balanced";
      tapping-term-ms = <2000>;
      quick-tap-ms = <175>;
      require-prior-idle-ms = <0>;
      hold-trigger-key-positions = <KEYS_R THUMBS>;
      hold-trigger-on-release;
      bindings =
        <&kp>,
        <&kp>;
    };

    hmr_s: hmr_s {
      // 1-й параметр = модификатор (hold), 2-й = буква (tap)
      display-name = "Home Row Mod - Right (no idle)";
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "balanced";
      tapping-term-ms = <2000>;
      quick-tap-ms = <175>;
      require-prior-idle-ms = <0>;
      hold-trigger-key-positions = <KEYS_L THUMBS>;
      hold-trigger-on-release;
      bindings =
        <&kp>,
        <&kp>;
    };

    smart_shift: smart_shift {
      display-name = "Smart Shift (Shift / Caps Word)";
      compatible = "zmk,behavior-mod-morph";
      #binding-cells = <0>;
      bindings = <&sk LSHIFT>, <&caps_word>;
      mods = <(MOD_LSFT)>;
    };
  };

  combos {
    compatible = "zmk,combos";

    // Х (в русской раскладке) = O + P
    combo_russian_x_letter {
      bindings = <&kp LEFT_BRACKET>;
      key-positions = <21 22>;
      layers = <BASE>;
    };

    // Э (в русской раскладке) = K + L
    combo_russian_e_letter {
      bindings = <&kp SQT>;
      key-positions = <33 34>;
      layers = <BASE>;
    };

    ESC_combo {
      bindings = <&kp ESC>;
      key-positions = <14 15>;
      layers = <BASE>;
    };

    tab_combo {
      bindings = <&kp TAB>;
      key-positions = <38 39>;
      layers = <BASE>;
    };

    // Разблокировка ZMK Studio (обе верхние крайние клавиши)
    combo_unlock {
      key-positions = <0 4>;
      bindings = <&studio_unlock>;
    };
  };

  chosen {
    zmk,physical-layout = &charybdis_6col_layout;
  };

  keymap {
    compatible = "zmk,keymap";

    // ---------------------------------------------------------------------
    // BASE — перенос старой раскладки.
    // Home row mods: A S D F / J K L ;  (новые hml/hmr)
    // &lt 4 Z и &lt 4 SLASH — удержание даёт слой FUNCTION (настройки)
    // &lt 2 TAB — удержание даёт SYMBOL, &lt 3 BACKSPACE — NUMBER
    // ---------------------------------------------------------------------
    Base {
        label = "Base";
        display-name = "Base";
        bindings = <
&trans  &trans        &trans        &trans         &trans         &trans          &trans        &trans         &trans         &trans          &trans           &trans
&trans  &kp Q         &kp W         &kp E          &kp R          &kp T           &kp Y         &kp U          &kp I          &kp O           &kp P            &trans
&trans  &hml LCTRL A  &hml LALT S   &hml LGUI D    &hml LSHIFT F  &kp G           &kp H         &hmr RSHIFT J  &hmr RGUI K    &hmr RALT L     &hmr RCTRL SEMI  &trans
&trans  &lt 4 Z       &kp X         &kp C          &kp V          &kp B           &kp N         &kp M          &kp COMMA      &kp DOT         &lt 4 SLASH      &trans
        &kp ESC       &kp SPACE     &lt 2 TAB      &kp DEL        &kp BACKSPACE   &lt 3 BACKSPACE  &kp SPACE                   &kp RETURN
        >;
    };

    // ---------------------------------------------------------------------
    // MOUSE — авто-слой (input-processor auto_mouse_layer).
    // Появляется при движении шарика с задержкой, пока шарик двигается.
    // ---------------------------------------------------------------------
    Mouse {
        label = "Mouse";
        display-name = "Mouse";
        bindings = <
&trans  &trans    &trans    &trans      &trans      &trans          &trans  &trans    &trans    &trans    &trans  &trans
&trans  &trans    &trans    &trans      &trans      &trans          &trans  &trans    &trans    &trans    &trans  &trans
&trans  &kp LGUI  &kp LALT  &kp LSHFT   &kp LCTRL   &trans          &trans  &mkp MB1  &mkp MB2  &mkp MB3  &trans  &trans
&trans  &trans    &trans    &trans      &trans      &trans          &trans  &trans    &trans    &trans    &trans  &trans
        &mkp MB1  &mkp MB2  &mkp MB3     &trans      &trans          &trans  &trans    &trans
        >;
    };

    // ---------------------------------------------------------------------
    // SYMBOL
    // ---------------------------------------------------------------------
    Sym {
        label = "Symbol";
        display-name = "Symbol";
        bindings = <
&trans  &trans           &trans            &trans                &trans         &trans     &trans    &trans        &trans       &trans       &trans         &trans
&trans  &kp EXCLAMATION  &kp AT_SIGN       &kp HASH              &kp DOLLAR     &kp PERCENT &kp LCTRL &kp AMPERSAND &kp ASTERISK &kp MINUS    &kp EQUAL      &trans
&trans  &kp GRAVE        &kp TILDE         &kp LEFT_PARENTHESIS  &kp LEFT_BRACE &kp LBKT   &kp LEFT  &kp DOWN      &kp UP       &kp RIGHT    &trans         &trans
&trans  &kp LESS_THAN    &kp GREATER_THAN  &kp RIGHT_PARENTHESIS &kp RIGHT_BRACE &kp RBKT  &kp PIPE  &trans        &kp KP_COMMA &kp KP_DOT   &kp KP_DIVIDE  &trans
        &trans           &trans            &trans                &trans         &trans     &trans    &trans        &trans
        >;
    };

    // ---------------------------------------------------------------------
    // NUMBER
    // ---------------------------------------------------------------------
    Num {
        label = "Number";
        display-name = "Number";
        bindings = <
&trans  &trans   &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp F10  &kp F7  &kp F8  &kp F9  &trans          &trans  &kp N7  &kp N8  &kp N9  &trans  &trans
&trans  &kp F11  &kp F4  &kp F5  &kp F6  &trans          &trans  &kp N4  &kp N5  &kp N6  &trans  &trans
&trans  &kp F12  &kp F3  &kp F2  &kp F1  &trans          &kp N0  &kp N1  &kp N2  &kp N3  &trans  &trans
        &trans   &trans  &trans  &trans  &trans          &trans  &trans  &trans
        >;
    };

    // ---------------------------------------------------------------------
    // FUNCTION — настройки.
    // Помимо медиа/BT/reset здесь ПЕРЕКЛЮЧАТЕЛИ РЕЖИМОВ трекбала:
    //   &tog 6 — SCROLL вкл/выкл (шарик скроллит)
    //   &tog 5 — SNIPE  вкл/выкл (точное движение)
    // ---------------------------------------------------------------------
    Fun {
        label = "Function";
        display-name = "Function";
        bindings = <
&kp F12  &kp F1       &kp F2          &kp F3            &kp F4             &kp F5                    &kp F6        &kp F7      &kp F8      &kp F9      &kp F10      &kp F11
&trans   &sys_reset   &bt BT_PRV      &bt BT_NXT        &bt BT_CLR         &out OUT_TOG              &bt BT_SEL 0  &bt BT_CLR  &bt BT_PRV  &bt BT_NXT  &sys_reset   &trans
&trans   &bootloader  &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT         &kp C_MUTE                &bt BT_SEL 1  &mkp MB1    &mkp MB2    &mkp MB3    &bootloader  &trans
&trans   &trans       &tog 6          &tog 5            &kp C_VOLUME_DOWN  &kp C_VOLUME_UP           &bt BT_SEL 2  &trans      &tog 5      &tog 6      &trans       &trans
                     &trans          &trans            &trans             &trans           &trans                    &trans        &trans      &trans
        >;
    };

    // ---------------------------------------------------------------------
    // SNIPE — точное движение шарика (включается тумблером из FUNCTION).
    // Левый верхний большой палец (48) выключает режим.
    // ---------------------------------------------------------------------
    Snipe {
        label = "Snipe";
        display-name = "Snipe";
        bindings = <
&trans  &trans  &trans  &trans  &trans  &trans          &trans    &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans    &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans    &mkp MB1  &mkp MB2  &mkp MB3  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans    &trans    &trans    &trans    &trans  &trans
        &tog 5  &trans  &trans  &trans  &trans          &trans    &trans    &trans
        >;
    };

    // ---------------------------------------------------------------------
    // SCROLL — скролл шариком (включается тумблером из FUNCTION).
    // Левый верхний большой палец (48) выключает режим.
    // ---------------------------------------------------------------------
    Scroll {
        label = "Scroll";
        display-name = "Scroll";
        bindings = <
&trans  &trans  &trans  &trans  &trans  &trans          &trans    &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans    &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans    &mkp MB1  &mkp MB2  &mkp MB3  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans    &trans    &trans    &trans    &trans  &trans
        &tog 6  &trans  &trans  &trans  &trans          &trans    &trans    &trans
        >;
    };
  };
};
